PORT=3000
HOST=127.0.0.1
# Set this to your exact public HTTPS origin when deploying.
APP_ORIGIN=http://localhost:3000
DB_PATH=data/brain.sqlite

# Optional: install Ollama separately and pull both models before enabling.
AI_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text

# Optional Resend email credentials. Use a verified sender/domain.
RESEND_API_KEY=
EMAIL_FROM=
