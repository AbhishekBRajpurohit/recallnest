{
  "manifest_version": 3,
  "name": "Second Brain Capture",
  "version": "1.0.0",
  "description": "Capture a webpage or selection into your local Second Brain workspace.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Capture to Second Brain"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
